# ==========================================================
# SAGE APPLICATION / DATABASE
# Development defaults keep your current local workflow. For public deployment set SAGE_ENV=production and PostgreSQL DATABASE_URL.
# ==========================================================
SECRET_KEY=change-this-before-production
SAGE_ENV=development
SAGE_DEBUG=true
SAGE_HOST=0.0.0.0
SAGE_PORT=5005
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sage_db
SAGE_SQLITE_FALLBACK=true
SAGE_AUTO_CREATE_SCHEMA=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_SECONDS=43200
TRUST_PROXY_HEADERS=false
FORCE_HTTPS=false

# ==========================================================
# FILE / OBJECT STORAGE
# local = current development storage. Production can use s3/r2 without changing finance/procurement code.
# ==========================================================
SAGE_STORAGE_BACKEND=local
SAGE_STORAGE_DIR=storage
MAX_UPLOAD_MB=12
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGNED_SECONDS=300
SAGE_BACKUP_DIR=backups

# ==========================================================
# SAGE PLATFORM ADMIN - DEVELOPER ONLY
# ==========================================================
SAGE_ADMIN_USERNAME=change-me
SAGE_ADMIN_PASSWORD=change-this-to-a-long-private-password

# ==========================================================
# EMAIL NOTIFICATIONS
# ==========================================================
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ==========================================================
# OPTIONAL WEB PUSH - PHASE 7
# Requires HTTPS in production. Generate a VAPID public/private key pair and keep the private key secret.
# ==========================================================
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ==========================================================
# OPTIONAL REDIS / DISTRIBUTED RUNTIME
# Used by rate limiting when configured; leave empty for local development.
# ==========================================================
REDIS_URL=
SAGE_AUDIT_RETENTION_DAYS=2555
SAGE_NOTIFICATION_RETENTION_DAYS=365

# ==========================================================
# GROQ - RESERVED FOR DOCUMENT / RECEIPT ANALYSIS
# Key priority remains 5 -> 4 -> 3. Keys 1 and 2 stay reserved.
# ==========================================================
GROQ_API_KEY=gsk_xxxxxx
GROQ_API_KEY2=gsk_Sxxxxxx
GROQ_API_KEY3=gsk_xxxxxxx
GROQ_API_KEY4=gsk_xxxxxxxx
GROQ_API_KEY5=gsk_xxxxxxx
GROQ_MODEL=openai/gpt-oss-120b

# ==========================================================
# OPENAI - SAGE AI
# ==========================================================
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL_SOLVER=gpt-5.4
OPENAI_MODEL_VERIFIER=gpt-5.4
